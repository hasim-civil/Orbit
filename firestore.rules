rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile during registration
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['name', 'email', 'role']) &&
                       request.resource.data.role in ['admin', 'employee'];
      
      // Users can update their own profile (but not role)
      allow update: if isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      
      // Admins can read all users
      allow read: if isAdmin();
      
      // Admins can update and delete any user
      allow update, delete: if isAdmin();
    }
    
    // Attendance collection
    match /attendance/{userId}/records/{date} {
      // Users can read their own attendance
      allow read: if isOwner(userId);
      
      // Users can create their own attendance (check-in)
      allow create: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['checkIn', 'status', 'date']) &&
                       request.resource.data.status == 'incomplete';

      // Users can also self-create a completed past-attendance record
      // (used by the "Add Past Attendance" form, which submits checkIn,
      // checkOut and totalHours together with status == 'present')
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['checkIn', 'checkOut', 'totalHours', 'status', 'date']) &&
                       request.resource.data.status == 'present';
      
      // Users can update their own attendance (check-out)
      allow update: if isOwner(userId) && 
                       request.resource.data.keys().hasAll(['checkOut', 'totalHours', 'status']);
      
      // Admins can read all attendance records
      allow read: if isAdmin();

      // Admins can create/update attendance records too (e.g. Add Past Attendance on behalf of an employee, corrections)
      allow create, update: if isAdmin();
      
      // Prevent deletion of attendance records (audit trail)
      allow delete: if false;
    }

    // Holidays collection (top-level, document ID = YYYY-MM-DD)
    // Every authenticated user needs to read these to know their own status;
    // only admins may add/edit/delete them.
    match /holidays/{date} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Paid Leave — simple model, no approval workflow. An employee marks
    // their own dates as Paid Leave directly; there is no pending/approved/
    // rejected status and no admin action required. Admins can still read
    // and manage any user's leave (e.g. from the Admin Dashboard) since the
    // data affects org-wide attendance reporting.
    match /paidLeaves/{userId}/records/{date} {
      // Owner can read their own leave; admin can read anyone's.
      allow read: if isOwner(userId) || isAdmin();

      // Owner can create their own leave record. Admin can create on behalf
      // of a user too (e.g. correcting attendance from the Admin Dashboard).
      allow create: if (isOwner(userId) || isAdmin()) &&
                       request.resource.data.keys().hasAll(['date', 'leaveType']);

      // Owner can edit their own leave (type/reason); admin can edit anyone's.
      allow update: if isOwner(userId) || isAdmin();

      // Owner can remove their own leave; admin can remove anyone's.
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
